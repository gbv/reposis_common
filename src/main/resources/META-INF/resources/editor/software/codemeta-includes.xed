<?xml version="1.0" encoding="UTF-8"?>
<xed:template
  xmlns:fn="http://www.w3.org/2005/xpath-functions"
  xmlns:mir="http://www.mycore.de/mir"
  xmlns:xed="http://www.mycore.de/xeditor">

  <!-- TODO -->
  <!-- funding -->
  <!-- related link -->
  <!-- isAccessibleForFree standard? -->
  <!-- supportingData -->
  <!-- softwareHelp -->
  <!-- targetProduct -->

  <xed:template id="rep.codemeta.developmentStatus">
    <xed:bind xpath="fn:map[@key='developmentStatus']">
      <xed:bind xpath="fn:string[@key='@type']">
        <input type="hidden" value="Text" />
      </xed:bind>
      <div class="form-group row">
        <label class="col-md-3 col-form-label text-right">
          <xed:output i18n="rep.metadata.software.developmentStatus" />
        </label>
        <div class="col-md-6">
          <xed:bind xpath="fn:string[@key='@value']" initially="">
            <select class="form-control form-control-inline">
              <option value="">
                <xed:output i18n="mir.select" />
              </option>
              <xed:include uri="xslStyle:items2options:classification:editorComplete:1:children:development_status" />
            </select>
          </xed:bind>
        </div>
        <mir:help-pmud help-text="{i18n:rep.editor.codemeta.developmentStatus.help}" pmud="false" />
      </div>
    </xed:bind>
  </xed:template>

  <xed:template id="rep.codemeta.version">
    <mir:textfield
      xpath="fn:string[@key='version']"
      label="rep.metadata.software.version"
      help-text="{i18n:rep.editor.codemeta.version.help}" />
  </xed:template>

  <xed:template id="rep.codemeta.applicationCategories">
    <xed:repeat xpath="fn:array[@key='applicationCategory']/fn:map">
      <xed:bind xpath="fn:string[@key='@type']">
        <input type="hidden" value="Text" />
      </xed:bind>
      <div class="form-group row">
        <label class="col-md-3 col-form-label text-right">
          <xed:output i18n="rep.metadata.software.applicationCategory" />
        </label>
        <div class="col-md-6">
          <xed:bind xpath="fn:string[@key='@value']">
            <input type="text" class="form-control form-control-inline" />
          </xed:bind>
        </div>
        <mir:help-pmud help-text="{i18n:rep.editor.codemeta.applicationCategory.help}" pmud="true" />
      </div>
    </xed:repeat>
  </xed:template>

  <xed:template id="rep.codemeta.applicationSubCategories">
    <xed:repeat xpath="fn:array[@key='applicationSubCategory']/fn:map">
      <xed:bind xpath="fn:string[@key='@type']">
        <input type="hidden" value="Text" />
      </xed:bind>
      <div class="form-group row">
        <label class="col-md-3 col-form-label text-right">
          <xed:output i18n="rep.metadata.software.applicationSubCategory" />
        </label>
        <div class="col-md-6">
          <xed:bind xpath="fn:string[@key='@value']">
            <input type="text" class="form-control form-control-inline" />
          </xed:bind>
        </div>
        <mir:help-pmud help-text="{i18n:rep.editor.codemeta.applicationSubCategory.help}" pmud="true" />
      </div>
    </xed:repeat>
  </xed:template>

  <xed:template id="rep.codemeta.programmingLanguages">
    <xed:repeat xpath="fn:array[@key='programmingLanguage']/fn:map">
      <xed:bind xpath="fn:string[@key='@type']">
        <input type="hidden" value="http://schema.org/ComputerLanguage" />
      </xed:bind>
      <div class="form-group row">
        <label class="col-md-3 col-form-label text-right">
          <xed:output i18n="rep.metadata.software.programmingLanguage" />
        </label>
        <div class="col-md-6">
          <xed:bind xpath="fn:string[@key='name']">
            <input type="text" class="form-control form-control-inline" />
          </xed:bind>
        </div>
        <mir:help-pmud help-text="{i18n:rep.editor.codemeta.programmingLanguage.help}" pmud="true" />
      </div>
    </xed:repeat>
  </xed:template>

  <xed:template id="rep.codemeta.operatingSystems">
    <xed:bind xpath="fn:array[@key='operatingSystem']">
      <mir:textfield
        xpath="fn:string"
        label="rep.metadata.software.operatingSystem"
        help-text="{i18n:rep.editor.codemeta.operatingSystem.help}"
        repeat="true" />
    </xed:bind>
  </xed:template>

  <xed:template id="rep.codemeta.processorRequirements">
    <xed:bind xpath="fn:array[@key='processorRequirement']">
      <mir:textfield
        xpath="fn:string"
        label="rep.metadata.software.processorRequirement"
        help-text="{i18n:rep.editor.codemeta.processorRequirement.help}"
        repeat="true" />
    </xed:bind>
  </xed:template>

  <xed:template id="rep.codemeta.memoryRequirements">
    <xed:repeat xpath="fn:array[@key='memoryRequirements']/fn:map">
      <xed:bind xpath="fn:string[@key='@type']">
        <input type="hidden" value="Text" />
      </xed:bind>
      <div class="form-group row">
        <label class="col-md-3 col-form-label text-right">
          <xed:output i18n="rep.metadata.software.memoryRequirement" />
        </label>
        <div class="col-md-6">
          <xed:bind xpath="fn:string[@key='@value']">
            <input type="text" class="form-control form-control-inline" />
          </xed:bind>
        </div>
        <mir:help-pmud help-text="{i18n:rep.editor.codemeta.memoryRequirement.help}" pmud="true" />
      </div>
    </xed:repeat>
  </xed:template>

  <xed:template id="rep.codemeta.storageRequirements">
    <xed:repeat xpath="fn:array[@key='storageRequirements']/fn:map">
      <xed:bind xpath="fn:string[@key='@type']">
        <input type="hidden" value="Text" />
      </xed:bind>
      <div class="form-group row">
        <label class="col-md-3 col-form-label text-right">
          <xed:output i18n="rep.metadata.software.storageRequirement" />
        </label>
        <div class="col-md-6">
          <xed:bind xpath="fn:string[@key='@value']">
            <input type="text" class="form-control form-control-inline" />
          </xed:bind>
        </div>
        <mir:help-pmud help-text="{i18n:rep.editor.codemeta.storageRequirement.help}" pmud="true" />
      </div>
    </xed:repeat>
  </xed:template>

  <xed:template id="rep.codemeta.runtimePlatforms">
    <xed:bind xpath="fn:array[@key='runtimePlatform']">
      <mir:textfield
        xpath="fn:string"
        label="rep.metadata.software.runtimePlatform"
        help-text="{i18n:rep.editor.codemeta.runtimePlatform.help}"
        repeat="true" />
    </xed:bind>
  </xed:template>
 
  <xed:template id="rep.codemeta.softwareRequirements">
    <xed:repeat xpath="fn:array[@key='softwareRequirements']/fn:map">
      <xed:bind xpath="fn:string[@key='@type']">
        <input type="hidden" value="SoftwareSourceCode" />
      </xed:bind>
      <div class="mir-fieldset-content-centered">
        <div class="form-group row d-flex align-items-center">
          <label class="col-md-3 col-form-label text-right">
            <xed:output i18n="rep.metadata.software.softwareRequirement" />
          </label>
          <div class="col-md-6 controls">
            <div class="row">
              <div class="col">
                <xed:bind xpath="fn:string[@key='name']">
                  <input
                    type="text"
                    class="form-control form-control-inline"
                    placeholder="{i18n:rep.editor.codemeta.softwareRequirement.name.placeholder}" />
                </xed:bind>
              </div>
            </div>
            <div class="row">
              <div class="col">
                <xed:bind xpath="fn:string[@key='codeRepository']">
                  <input
                    type="text"
                    class="form-control form-control-inline"
                    placeholder="{i18n:rep.editor.codemeta.softwareRequirement.link.placeholder}" />
                  <xed:validate
                    class="de.gbv.reposis.editor.ValidationUtils"
                    method="isValidURL"
                    i18n="rep.validation.invalidURL"
                    display="global" />
                </xed:bind>
              </div>
            </div>
          </div>
          <mir:help-pmud help-text="{i18n:rep.metadata.software.softwareRequirement.help}" pmud="true" />
        </div>
      </div>
    </xed:repeat>
  </xed:template>

  <xed:template id="rep.codemeta.softwareSuggestions">
    <xed:repeat xpath="fn:array[@key='softwareSuggestions']/fn:map">
      <xed:bind xpath="fn:string[@key='@type']">
        <input type="hidden" value="SoftwareSourceCode" />
      </xed:bind>
      <div class="mir-fieldset-content-centered">
        <div class="form-group row d-flex align-items-center">
          <label class="col-md-3 col-form-label text-right">
            <xed:output i18n="rep.metadata.software.softwareSuggestion" />
          </label>
          <div class="col-md-6 controls">
            <div class="row">
              <div class="col">
                <xed:bind xpath="fn:string[@key='name']">
                  <input
                    type="text"
                    class="form-control form-control-inline"
                    placeholder="{i18n:rep.editor.codemeta.softwareSuggestion.name.placeholder}" />
                </xed:bind>
              </div>
            </div>
            <div class="row">
              <div class="col">
                <xed:bind xpath="fn:string[@key='codeRepository']">
                  <input
                    type="text"
                    class="form-control form-control-inline"
                    placeholder="{i18n:rep.editor.codemeta.softwareSuggestion.link.placeholder}" />
                  <xed:validate
                    class="de.gbv.reposis.editor.ValidationUtils"
                    method="isValidURL"
                    i18n="rep.validation.invalidURL"
                    display="global" />
                </xed:bind>
              </div>
            </div>
          </div>
          <mir:help-pmud help-text="{i18n:rep.editor.codemeta.softwareSuggestion.help}" pmud="true" />
        </div>
      </div>
    </xed:repeat>
  </xed:template>

  <xed:template id="rep.codemeta.permissions">
    <xed:bind xpath="fn:array[@key='permissions']">
      <mir:textfield
        xpath="fn:string"
        label="rep.metadata.software.permission"
        help-text="{i18n:rep.editor.codemeta.permission.help}"
        repeat="true" />
    </xed:bind>
  </xed:template>

  <xed:template id="rep.codemeta.codeRepository">
    <mir:textfield
      xpath="fn:string[@key='codeRepository']"
      label="rep.metadata.software.codeRepository"
      help-text="{i18n:rep.editor.codemeta.codeRepository.help}" />
    <xed:validate
      xpath="//fn:string[@key='codeRepository']"
      class="de.gbv.reposis.editor.ValidationUtils"
      method="isValidURL"
      i18n="rep.editor.validation.invalidURL"
      display="global" />
  </xed:template>

  <xed:template id="rep.codemeta.buildInstructions">
    <mir:textfield
      xpath="fn:string[@key='buildInstructions']"
      label="rep.metadata.software.buildInstructions"
      help-text="{i18n:rep.editor.codemeta.buildInstructions.help}" />
    <xed:validate
      xpath="//fn:string[@key='buildInstructions']"
      class="de.gbv.reposis.editor.ValidationUtils"
      method="isValidURL"
      i18n="rep.editor.validation.invalidURL"
      display="global" />
  </xed:template>

  <xed:template id="rep.codemeta.releaseNotes">
    <mir:textfield
      xpath="fn:string[@key='releaseNotes']"
      label="rep.metadata.software.releaseNotes"
      help-text="{i18n:rep.editor.codemeta.releaseNotes.help}" />
    <xed:validate
      xpath="//fn:string[@key='releaseNotes']"
      class="de.gbv.reposis.editor.ValidationUtils"
      method="isValidURL"
      i18n="rep.editor.validation.invalidURL"
      display="global" />
  </xed:template>

  <xed:template id="rep.codemeta.contIntegration">
    <mir:textfield
      xpath="fn:string[@key='contIntegration']"
      label="rep.metadata.software.contIntegration"
      help-text="{i18n:rep.editor.codemeta.contIntegration.help}" />
    <xed:validate
      xpath="//fn:string[@key='contIntegration']"
      class="de.gbv.reposis.editor.ValidationUtils"
      method="isValidURL"
      i18n="rep.editor.validation.invalidURL"
      display="global" />
  </xed:template>

  <xed:template id="rep.codemeta.issueTracker">
    <mir:textfield
      xpath="fn:string[@key='issueTracker']"
      label="rep.metadata.software.issueTracker"
      help-text="{i18n:rep.editor.codemeta.issueTracker.help}" />
    <xed:validate
      xpath="//fn:string[@key='issueTracker']"
      class="de.gbv.reposis.editor.ValidationUtils"
      method="isValidURL"
      i18n="rep.editor.validation.invalidURL"
      display="global" />
  </xed:template>

  <xed:template id="rep.codemeta.readme">
    <mir:textfield
      xpath="fn:string[@key='readme']"
      label="rep.metadata.software.readme"
      help-text="{i18n:rep.editor.codemeta.readme.help}" />
    <xed:validate
      xpath="//fn:string[@key='readme']"
      class="de.gbv.reposis.editor.ValidationUtils"
      method="isValidURL"
      i18n="rep.editor.validation.invalidURL"
      display="global" />
  </xed:template>

  <xed:template id="rep.codemeta.cleanupRules">
    <xed:cleanup-rule xpath="//mods:extension[@type='codemeta-part']" relevant-if="*" />
    <xed:cleanup-rule
      xpath="//mods:extension[@type='codemeta-part']//fn:string"
      relevant-if="(string-length(text()) &gt; 0)" />
    <xed:cleanup-rule xpath="//mods:extension[@type='codemeta-part']//fn:array" relevant-if="*" />
    <xed:cleanup-rule xpath="//mods:extension[@type='codemeta-part']//fn:map" relevant-if="(count(*) &gt; 1)" />
  </xed:template>

</xed:template>
